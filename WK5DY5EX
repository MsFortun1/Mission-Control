import pygame
import random

# INITIALIZE PYGAME
pygame.init()

# Screen
WIDTH = 800
HEIGHT = 600

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Catch the Falling Star")

# Clock
clock = pygame.time.Clock()

# COLORS
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BLUE = (50, 100, 255)
YELLOW = (255, 220, 0)
RED = (255, 0, 0)
GREEN = (0, 200, 0)

# FONTS
font = pygame.font.Font(None, 36)
big_font = pygame.font.Font(None, 70)

# PLAYER SETTINGS

PLAYER_WIDTH = 100
PLAYER_HEIGHT = 20

player_x = WIDTH // 2 - PLAYER_WIDTH // 2
player_y = HEIGHT - 60

player_speed = 8

# STAR SETTINGS
STAR_SIZE = 25

star_x = random.randint(0, WIDTH - STAR_SIZE)
star_y = -STAR_SIZE

star_speed = 5


# GAME VARIABLES
score = 0
misses = 0

game_started = False
game_over = False

# Timer
start_time = 0
game_time = 60

# RESET GAME FUNCTION

def reset_game():
    global player_x
    global star_x
    global star_y
    global star_speed
    global score
    global misses
    global game_started
    global game_over
    global start_time

    player_x = WIDTH // 2 - PLAYER_WIDTH // 2

    star_x = random.randint(0, WIDTH - STAR_SIZE)
    star_y = -STAR_SIZE

    star_speed = 5

    score = 0
    misses = 0

    game_started = True
    game_over = False

    start_time = pygame.time.get_ticks()

# MAIN GAME LOOP
running = True

while running:

    # Keep game running at 60 FPS
    clock.tick(60)

    # EVENTS
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            # SPACE starts the game
            if event.key == pygame.K_SPACE and not game_started:
                reset_game()

            # R restarts after Game Over
            if event.key == pygame.K_r and game_over:
                reset_game()

            # X closes the game
            if event.key == pygame.K_x:
                running = False

    # PLAYER MOVEMENT
    keys = pygame.key.get_pressed()

    if game_started and not game_over:

        if keys[pygame.K_LEFT]:
            player_x -= player_speed

        if keys[pygame.K_RIGHT]:
            player_x += player_speed

        # Stop player from leaving screen
        if player_x < 0:
            player_x = 0

        if player_x > WIDTH - PLAYER_WIDTH:
            player_x = WIDTH - PLAYER_WIDTH

    # GAME LOGIC
    if game_started and not game_over:

        # Move the star downward
        star_y += star_speed

        # COLLISION DETECTION

        player_rect = pygame.Rect(
            player_x,
            player_y,
            PLAYER_WIDTH,
            PLAYER_HEIGHT
        )

        star_rect = pygame.Rect(
            star_x,
            star_y,
            STAR_SIZE,
            STAR_SIZE
        )

        # If player catches the star
        if player_rect.colliderect(star_rect):

            score += 1

            # Increase speed after every catch
            star_speed += 0.5

            # Bonus points for faster catching
            elapsed_time = (pygame.time.get_ticks() - start_time) / 1000

            if elapsed_time < 10:
                score += 2

            # Create a new star
            star_x = random.randint(0, WIDTH - STAR_SIZE)
            star_y = -STAR_SIZE

        # STAR MISSED
        if star_y > HEIGHT:

            misses += 1

            # Put star back at top
            star_x = random.randint(0, WIDTH - STAR_SIZE)
            star_y = -STAR_SIZE

            # Three misses = Game Over
            if misses >= 3:
                game_over = True

        # TIMER
        elapsed_time = (pygame.time.get_ticks() - start_time) / 1000
        remaining_time = game_time - int(elapsed_time)

        if remaining_time <= 0:
            remaining_time = 0
            game_over = True

    # DRAW BACKGROUND
    screen.fill(BLACK)

    # START SCREEN
    if not game_started:

        title = big_font.render(
            "Catch the Falling Star",
            True,
            WHITE
        )

        instruction = font.render(
            "Press SPACE to start",
            True,
            WHITE
        )

        close_text = font.render(
            "Press X to quit",
            True,
            WHITE
        )

        screen.blit(
            title,
            (WIDTH // 2 - title.get_width() // 2, 200)
        )

        screen.blit(
            instruction,
            (WIDTH // 2 - instruction.get_width() // 2, 300)
        )

        screen.blit(
            close_text,
            (WIDTH // 2 - close_text.get_width() // 2, 350)
        )

    # GAME SCREEN
    elif not game_over:

        # Draw player
        pygame.draw.rect(
            screen,
            BLUE,
            (player_x, player_y, PLAYER_WIDTH, PLAYER_HEIGHT)
        )

        # Draw star
        pygame.draw.circle(
            screen,
            YELLOW,
            (
                star_x + STAR_SIZE // 2,
                star_y + STAR_SIZE // 2
            ),
            STAR_SIZE // 2
        )

        # Score
        score_text = font.render(
            f"Score: {score}",
            True,
            WHITE
        )

        # Misses
        miss_text = font.render(
            f"Misses: {misses}/3",
            True,
            RED
        )

        # Timer
        time_text = font.render(
            f"Time: {remaining_time}",
            True,
            GREEN
        )

        screen.blit(score_text, (20, 20))
        screen.blit(miss_text, (20, 60))
        screen.blit(time_text, (WIDTH - 150, 20))

    # GAME OVER SCREEN
    else:

        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        final_score_text = font.render(
            f"Final Score: {score}",
            True,
            WHITE
        )

        miss_text = font.render(
            f"Misses: {misses}",
            True,
            WHITE
        )

        restart_text = font.render(
            "Press R to play again",
            True,
            GREEN
        )

        quit_text = font.render(
            "Press X to quit",
            True,
            WHITE
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 - game_over_text.get_width() // 2,
                170
            )
        )

        screen.blit(
            final_score_text,
            (
                WIDTH // 2 - final_score_text.get_width() // 2,
                270
            )
        )

        screen.blit(
            miss_text,
            (
                WIDTH // 2 - miss_text.get_width() // 2,
                315
            )
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 - restart_text.get_width() // 2,
                380
            )
        )

        screen.blit(
            quit_text,
            (
                WIDTH // 2 - quit_text.get_width() // 2,
                425
            )
        )

    
    # UPDATE DISPLAY
    pygame.display.flip()

# CLOSE PYGAME
#add explanatory commit

pygame.quit()